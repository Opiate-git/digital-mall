# No scripts in upload/, images only (Options/php_flag not allowed on shared hosts like InfinityFree)
<FilesMatch "\.(php\d?|phtml|phar|cgi|pl|py|sh|htm|html)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
